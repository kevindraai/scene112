extends SceneTree
const Fire = preload("res://scripts/fire_case.gd")
const Investigation = preload("res://scripts/investigation_case.gd")
var checks := 0
var failures := 0
func check(ok: bool, label: String) -> void:
	checks += 1
	if not ok: failures += 1; push_error("RESEARCH_FAIL " + label)
func _initialize() -> void: call_deferred("run")
func incident(burnout: bool = false) -> Dictionary:
	var fire := Fire.new()
	fire.begin("campaign")
	for step: String in Fire.BASICS: fire.complete_step(step)
	fire.check_recon("exterior")
	fire.check_recon("door")
	fire.connect_water()
	fire.add_hose_point(Vector3(2, 0, 44))
	fire.choose_tactic("interior")
	fire.spray("front", 0.3)
	fire.pickup_victim()
	fire.rescue_victim()
	if burnout:
		for index in 250: fire.tick(5)
	else:
		for id: String in ["front", "origin", "side"]:
			for index in 8: fire.spray(id, 0.5); fire.tick(0.5)
	fire.finish()
	return fire.to_dict()
func run() -> void:
	var model := Investigation.new()
	var original := incident()
	var baseline: Dictionary = original.duplicate(true)
	check(model.begin("campaign", original), "Completed actual fire starts chained investigation")
	check(not model.collect("connection"), "Source photograph required before object collection")
	for id: String in ["overview", "origin", "connection", "living", "entry_record", "dispatch_record"]:
		check(model.photograph(id, 0.8), "Meaningful photograph " + id)
		check(model.collect(id), "Source/timestamp evidence " + id)
	check(model.incident == baseline and original == baseline, "Incident state remains immutable")
	for person: String in ["saar", "lars"]:
		check(model.question(person, "open"), "Distinct actual source statement " + person)
		check(model.question(person, "timeline"), "Independent timeline " + person)
	check(model.question("lars", "show_entry") and model.witnesses.lars.contradiction, "Selective real evidence exposes presence contradiction without guilt shortcut")
	for id: String in ["origin_connection", "entry_contradiction", "alternative_tested", "response_effect"]: check(model.link_evidence(id), "Board relates known facts " + id)
	check(model.request_lab() and not model.receive_lab(), "Object follow-up is a separate delayed step")
	for index in 4: model.tick(5)
	check(model.receive_lab(), "Preserved physical object can receive limited expert result")
	model.choose_hypothesis("intentional")
	var selected: Array = model.report_cards().keys()
	check(model.submit_report(selected).outcome == "wrong" and model.phase == "report", "Presence and unqualified repair do not prove intentional fire")
	model.choose_hypothesis("electrical")
	check(model.submit_report(["limits", "statement_saar", "statement_lars"]).outcome == "incomplete" and model.phase == "report", "Collected but uncited physical/lab sources cannot support a careful report")
	check(model.submit_report(selected).outcome == "careful" and model.phase == "completed", "Corroborated alternative-aware report closes case without confession")
	var saved: Dictionary = JSON.parse_string(JSON.stringify(model.to_dict(), "", true, true))
	var loaded := Investigation.new()
	check(loaded.restore(saved) and loaded.report.outcome == "careful" and loaded.incident == saved.incident, "Completed journal replay after real JSON preserves fire and outcome")
	var good: Dictionary = loaded.to_dict()
	var forged: Dictionary = saved.duplicate(true)
	forged.events[0].kind = "instant_truth_scan"
	check(not loaded.restore(forged) and loaded.to_dict() == good, "Unknown forged operation rejected atomically")
	var burned := Investigation.new()
	check(burned.begin("campaign", incident(true)), "Burned-out incident has its own preserved aftermath")
	check(burned.evidence_quality("connection") < model.evidence_quality("connection") * 0.1, "Firefighting choices genuinely affect remaining evidence")
	for id: String in ["overview", "origin", "connection", "living", "entry_record", "dispatch_record"]: burned.photograph(id, 0.8); burned.collect(id)
	for person: String in ["saar", "lars"]: burned.question(person, "open"); burned.question(person, "timeline")
	burned.question("lars", "show_entry")
	for id: String in ["origin_connection", "entry_contradiction", "alternative_tested", "response_effect"]: burned.link_evidence(id)
	burned.request_lab()
	for index in 4: burned.tick(5)
	burned.receive_lab()
	burned.choose_hypothesis("electrical")
	check(burned.submit_report(burned.report_cards().keys()).outcome == "wrong", "Destroyed evidence cannot support overconfident cause")
	burned.choose_hypothesis("unknown")
	check(burned.submit_report(burned.report_cards().keys()).outcome == "careful", "Honest uncertainty is careful when evidence is destroyed")
	var pressure := Investigation.new()
	pressure.begin("practice", original)
	check(pressure.question("lars", "suggestive") and pressure.witnesses.lars.stopped, "Witness request to stop is effective")
	check(not pressure.question("lars", "open"), "Stopped witness cannot be questioned")
	pressure.interview_action("lars", "resume_voluntary")
	pressure.photograph("connection", 0.8); pressure.collect("connection")
	pressure.question("lars", "repair")
	check(pressure.interview_action("lars", "suspect"), "Formal police path is separately recorded")
	check(not pressure.question("lars", "open"), "Suspect question blocked before cautie/support")
	pressure.interview_action("lars", "explanation")
	pressure.interview_action("lars", "cautie")
	pressure.interview_action("lars", "lawyer")
	check(pressure.question("lars", "open"), "Adult fictional formal interview after explanation/cautie/support")
	print("SCENE112_INVESTIGATION_TESTS_OK checks=", checks, " failures=", failures)
	quit(0 if failures == 0 else 1)
