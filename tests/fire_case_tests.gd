extends SceneTree
const Fire = preload("res://scripts/fire_case.gd")
var checks := 0
func check(ok: bool, message: String) -> void:
	checks += 1
	if not ok:
		push_error("FIRE_TEST_FAIL " + message)
		quit(1)
		assert(ok, message)
func _initialize() -> void:
	var fire := Fire.new()
	check(not fire.choose_tactic("interior"), "unprepared entry refused")
	check(not fire.tick(1), "inactive incident cannot tick")
	check(fire.begin("campaign"), "campaign starts")
	check(not fire.complete_step("drive"), "actual preparation order")
	for id in Fire.BASICS: check(fire.complete_step(id), "basic " + id)
	check(not fire.connect_water(), "recon before water")
	check(fire.check_recon("exterior"), "outside recon")
	check(fire.connect_water(), "actual water supply")
	check(not fire.choose_tactic("interior"), "entry recon required")
	check(fire.check_recon("door"), "access recon")
	check(fire.choose_tactic("defensive"), "defensive choice valid")
	check(not fire.spray("origin", 1), "no global magical suppression without hose")
	check(not fire.add_hose_point(Vector3(-1, 0, 44)), "long first segment exceeds maximum")
	check(fire.add_hose_point(Vector3(2, 0, 44)), "first hose segment")
	check(fire.add_hose_point(Vector3(-2, 0, 45)), "second hose segment")
	check(fire.has_nozzle_at(Vector3(-2, 0, 44)), "nozzle connected near actual line")
	check(not fire.has_nozzle_at(Vector3(25, 0, 44)), "nozzle cannot teleport away from line")
	var before: Dictionary = fire.to_dict()
	check(fire.spray("front", 0.1), "one raycast target cooled")
	check(fire.cells[0].heat < before.cells[0].heat and fire.cells[1].heat == before.cells[1].heat, "spray changes just aimed cell")
	check(fire.water_liters < before.water_liters and fire.water_used > 0, "finite resource consumed")
	var alternative := Fire.new()
	check(alternative.restore(fire.to_dict()), "compare tactic with identical physical preparation")
	alternative.tactic = "interior"
	alternative.spray("front", 0.3)
	fire.spray("front", 0.3)
	check(alternative.can_enter() and not fire.can_enter(), "protected interior plan permits earlier rescue while defensive plan requires stronger cooling")
	check(not fire.spray("unknown", 1), "unmatched ray hit refused")
	var before_miss: Dictionary = fire.to_dict()
	check(fire.spray("", 0.1), "open connected nozzle flows despite an actual missed aim")
	check(fire.water_used > before_miss.water_used and fire.water_liters < before_miss.water_liters and fire.cells == before_miss.cells, "missed stream spends finite water without magical cooling")
	check(not fire.tick(NAN) and not fire.tick(-1) and not fire.tick(500), "invalid time refused")
	check(not fire.pickup_victim(), "hot access prevents carrying")
	check(fire.tick(1, true) and fire.unsafe_seconds == 1 and fire.oxygen < 100, "unsafe entry has consequences")
	var active := fire.to_dict()
	var loaded := Fire.new()
	check(loaded.restore(active) and loaded.to_dict() == active, "active snapshot exact")
	check(loaded.restore(JSON.parse_string(JSON.stringify(active, "", true, true))), "platform JSON roundtrip")
	for id in ["front", "origin", "side"]:
		for i in range(8):
			check(fire.spray(id, 0.5), "aimed sustained nozzle")
			check(fire.tick(0.5), "real burn clock continues during suppression")
	check(fire.can_enter(), "cooled bounded room allows protected search")
	check(fire.pickup_victim(), "victim carried")
	check(fire.finish(true).is_empty() and fire.phase == "active" and fire.victim.status == "carried", "Carried victim cannot become trapped by completed withdrawal")
	check(fire.rescue_victim(), "victim brought outside")
	check(fire.all_cold(), "individual fires extinguished")
	var grade: Dictionary = fire.finish()
	check(grade.result == "careful" and fire.phase == "completed", "careful complete result")
	check(fire.finish() == grade and not fire.spray("front", 1), "finished handover immutable")
	var finished := fire.to_dict()
	check(loaded.restore(finished) and loaded.report_score == grade, "persistent incident and score")
	var bad: Dictionary = finished.duplicate(true)
	bad.report_score.total = 1
	check(not loaded.restore(bad) and loaded.to_dict() == finished, "forged score refused atomically")
	bad = finished.duplicate(true)
	bad.cells[0].burned = 0.8
	check(not loaded.restore(bad), "physical fuel conservation checked")
	bad = finished.duplicate(true)
	bad.hose_points.append([100.0, 0.0, 44.0])
	check(not loaded.restore(bad), "invalid persistent hose refused")
	bad = finished.duplicate(true)
	bad.victim.exposure = NAN
	check(not loaded.restore(bad), "nonfinite victim refused")
	var ignored := Fire.new()
	ignored.restore(active)
	for i in range(230): ignored.tick(5, true)
	check(ignored.victim.status == "lost" and ignored.oxygen == 0, "time, smoke and exposure consequence")
	check(ignored.finish(true).result == "partial", "withdrawal keeps partial persistent outcome")
	var burnout := Fire.new()
	check(burnout.restore(active), "Burnout regression starts actual prepared snapshot")
	burnout.tactic = "interior"
	burnout.spray("front", 0.3)
	check(burnout.pickup_victim() and burnout.rescue_victim(), "Burnout regression rescues without suppressing all cells")
	for i in range(250): burnout.tick(5, false)
	check(burnout.all_cold(), "Fuel exhaustion genuinely becomes cold")
	var burnout_grade := burnout.finish()
	check(burnout_grade.result == "partial" and burnout_grade.suppression < 3 and burnout_grade.total < 85, "Letting the house burn out never earns careful suppression")
	check(loaded.restore(burnout.to_dict()), "Partial burnout survives investigation handoff")
	print("SCENE112_FIRE_CASE_TESTS_OK checks=", checks)
	quit(0)
